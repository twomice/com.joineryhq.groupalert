<?xml version="1.0"?>
<extension key="com.joineryhq.groupalert" type="module">
  <file>groupalert</file>
  <name>Group Contact Alert</name>
  <description>Provides an API suitable for use with Scheduled Jobs, to send you an email if the given group contains contacts.</description>
  <license>GPL-3.0</license>
  <maintainer>
    <author>Allen Shaw</author>
    <email>allen@JoineryHQ.com</email>
  </maintainer>
  <urls>
    <url desc="Main Extension Page">https://github.com/twomice/com.joineryhq.groupalert</url>
    <url desc="Documentation">https://github.com/twomice/com.joineryhq.groupalert</url>
    <url desc="Support">https://github.com/twomice/com.joineryhq.groupalert/issues</url>
    <url desc="Licensing">http://www.gnu.org/licenses/gpl-3.0.html</url>
  </urls>
  <releaseDate>2021-04-20</releaseDate>
  <version>0.2.1</version>
  <develStage>beta</develStage>
  <compatibility>
    <ver>5.51</ver>
  </compatibility>
  <comments/>
  <civix>
    <namespace>CRM/Groupalert</namespace>
    <format>25.10.2</format>
  </civix>
  <mixins>
    <mixin>mgd-php@2.0.0</mixin>
    <mixin>scan-classes@1.0.0</mixin>
  </mixins>
  <classloader>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
</extension>
